# Copia questo file in .env (che è ignorato da git) e compila i valori.
# Su GitHub NON creare .env: usa Settings → Secrets and variables → Actions.

# --- Registro elettronico ---
SCHOOL_USERNAME=
SCHOOL_PASSWORD=

# --- Telegram (opzionale ma consigliato) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Percorso del file letto dal sito ---
# Default: data/homework.json
# SITE_DATA_FILE=/percorso/assoluto/homework.json

# --- Firebase Realtime Database (opzionale) ---
# Se configurato, il bot scrive anche /homework.json sul database.
# FIREBASE_DB_URL=https://tuo-progetto-default-rtdb.europe-west1.firebasedatabase.app
# FIREBASE_DB_SECRET=

# --- Interno ---
# Impostato a 1 dal workflow schedulato: esegue solo alle 14:00 italiane.
# SCHEDULED=0
